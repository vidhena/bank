pipeline {
    agent any

    stages {

        stage('Compile') {
            steps {
                bat 'javac *.java'
            }
        }

        stage('Run') {
            steps {
                bat 'java Main'
            }
        }
    }

    post {

        success {
            echo 'Build Successful'
        }

        failure {
            echo 'Build Failed'
        }
    }
}
